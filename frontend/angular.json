{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {"equipos": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {
        "browser": "src/main.ts", "tsConfig": "tsconfig.json", "index": "src/index.html",
        "styles": ["src/styles.scss"], "outputPath": "dist", "outputHashing": "all",
        "budgets": [{"type": "initial", "maximumWarning": "1mb", "maximumError": "2mb"}]
      }},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "equipos:build"}}
    }
  }},
  "cli": {"analytics": false}
}

